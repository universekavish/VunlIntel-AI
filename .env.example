# Copy this file to .env before starting the Compose stack.
# Keep passwords URL-safe (letters and numbers) unless URL-encoding them in the DSNs.
POSTGRES_USER=vulnintel
POSTGRES_PASSWORD=localdevpassword
POSTGRES_DB=vulnintel
REDIS_PASSWORD=localredispassword

# Local published ports (all Compose ports bind to loopback only).
API_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
MLFLOW_PORT=5000

# Application service connection strings inside Docker Compose.
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
QDRANT_URL=http://qdrant:6333
MLFLOW_TRACKING_URI=http://mlflow:5000

# Authentication and API configuration. The sample key is for local development only.
JWT_SECRET=local-only-change-this-secret-before-deploying-7b09ac492f82487d
JWT_ISSUER=vulnintel-ai
JWT_AUDIENCE=vulnintel-api
ACCESS_TOKEN_TTL_MINUTES=30
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Official vulnerability data sources.
NVD_API_KEY=
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
EPSS_API_URL=https://api.first.org/data/v1/epss
EPSS_DAILY_URL=https://epss.empiricalsecurity.com/epss_scores-current.csv.gz
OSV_API_URL=https://api.osv.dev
CWE_DOWNLOAD_URL=https://cwe.mitre.org/data/xml/cwec_latest.xml.zip

# RAG and embedding configuration.
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_DIMENSIONS=384
RAG_VECTORSTORE_COLLECTION=vulnintel
RAG_EMBEDDING_PROVIDER=sentence_transformer

# Optional ML/inference configuration. Fine-tuning is never required at application startup.
VULNINTEL_ML_ENABLED=false
VULNINTEL_ML_BASE_MODEL=
VULNINTEL_ML_ADAPTER_PATH=

# Provider selection and credentials are configured only when a later phase uses an LLM.
LLM_PROVIDER=
LLM_API_KEY=
